# The deliberately buggy Toolshop build: proves the suite catches real defects. No secrets here.
BASE_URL=https://with-bugs.practicesoftwaretesting.com
API_BASE_URL=https://api-with-bugs.practicesoftwaretesting.com
ADMIN_EMAIL=admin@practicesoftwaretesting.com
# The with-bugs backend is an older Toolshop API: numeric ids, flat address fields (src/api/dialect.ts)
API_DIALECT=legacy
# Its Angular app uses hash routing: /#/product/1
ROUTE_PREFIX="/#"
# Keeps the JWT in sessionStorage, not localStorage
TOKEN_STORAGE=session
