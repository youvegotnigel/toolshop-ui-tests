# Copy to .env.local (git-ignored) and fill in. CI uses the repository secret TOOLSHOP_ADMIN_PASSWORD.
# Public Toolshop demo passwords are published at https://github.com/testsmith-io/practice-software-testing
ADMIN_PASSWORD=
# No customer password needed: each worker registers its own throwaway customer.

# Optional
# TEST_ENV=public        # public (default) | with-bugs
# LOG_LEVEL=info         # debug | info | warn | error   (console)
# LOG_FILE_LEVEL=info    # debug | info | warn | error   (logs/automation_framework.log; debug adds API calls)
# LOG_STREAM=           # 1 = print lines live, 0 = one block per test; default: live only with one worker
# ALLURE=1               # also write allure-results/
