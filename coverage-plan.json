      "priority": "critical",
      "target": "0.2"
    },
    { "id": "auth.logout", "title": "Sign out", "area": "auth", "priority": "high", "target": "0.2" },
    {
      "id": "cart.update",
      "title": "Change the quantity in the cart",
      "area": "cart",
      "priority": "high",
      "target": "0.1"
    },
    {
      "id": "cart.remove",
      "title": "Remove an item from the cart",
      "area": "cart",
      "priority": "high",
      "target": "0.2"
    },
    {
      "id": "checkout.card",
      "title": "Check out signed in, paying by card",
      "area": "checkout",
      "priority": "critical",
      "target": "0.1"
    },
    {
      "id": "checkout.guest",
      "title": "Check out as a guest",
      "area": "checkout",
      "priority": "critical",
      "target": "0.2"
    },
    {
      "id": "checkout.payment-methods",
      "title": "Pay by bank transfer, gift card, buy now pay later",
      "area": "checkout",
      "priority": "high",
      "target": "0.2"
    },
    {
      "id": "account.profile",
      "title": "Update the profile",
      "area": "account",
