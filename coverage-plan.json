    },
    {
      "id": "account.contact",
      "title": "Send a contact message",
      "area": "account",
      "priority": "normal",
      "target": "0.3"
    },
    {
      "id": "admin.products",
      "title": "An admin manages products",
      "area": "admin",
      "priority": "high",
      "target": "0.3"
    },
    {
      "id": "admin.orders",
      "title": "An admin updates an order status",
      "area": "admin",
      "priority": "high",
      "target": "0.3"
    }
  ]
}
