{
  "name": "toolshop-ui-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic Playwright + TypeScript UI test framework for the Practice Software Testing Toolshop web store",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "allure": "3.33.0",
    "allure-js-commons": "3.15.0",
    "allure-playwright": "3.15.0",
    "cross-env": "10.1.0",
    "dotenv": "18.0.10",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "zod": "4.6.7"
  },
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:shuffle": "playwright test --shuffle --repeat-each=2",
    "test:with-bugs": "cross-env TEST_ENV=with-bugs playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "agent:parity": "node scripts/agent-parity.mts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run agent:parity && npm test",
    "report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results",
    "allure:report": "npm run allure:generate && allure open",
    "report:dashboard": "node scripts/coverage/index.mts",
    "report:site": "scripts/ci/build-site.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
